# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True

# ── Settings module ───────────────────────────────────────────────────────────
# Development (default): config.settings.development
# Production:            config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# ── Hosts & CORS ──────────────────────────────────────────────────────────────
# Development: localhost,127.0.0.1
# Production:  include your Railway domain and any custom domain
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed frontend origins (required in production)
# CORS_ALLOWED_ORIGINS=https://grabit.sale,https://your-pages-url.pages.dev

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Transaction pooler (port 6543) — used for all live queries
SUPABASE_TRANSACTION_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — used only for migrations
SUPABASE_DIRECT_URI=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Cloudflare R2 (production media storage) ─────────────────────────────────
# R2_BUCKET_NAME=grabit-media
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.grabit.sale

# ── Email (production SMTP) ───────────────────────────────────────────────────
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@grabit.sale

# ── Fapshi — collection service (buyer payments) ──────────────────────────────
# Two modes depending on which vars are set:
#
# PROXY mode (production): FAPSHI_BASE_URL = Cloudflare Worker URL
#   FAPSHI_PROXY_SECRET authenticates Railway to the Worker.
#   FAPSHI_API_USER / FAPSHI_API_KEY are NOT needed here — they live in the Worker.
#
# DIRECT mode (local dev): FAPSHI_BASE_URL = https://sandbox.fapshi.com
#   FAPSHI_PROXY_SECRET is absent or empty.
#   FAPSHI_API_USER / FAPSHI_API_KEY required.
#
# Dashboard: sandbox.fapshi.com → log in → select your collection service
FAPSHI_BASE_URL=https://sandbox.fapshi.com
# Proxy mode only — must match the secret configured in the Cloudflare Worker
# FAPSHI_PROXY_SECRET=
# Direct mode only — "API User" and "API Key" under collection service > API credentials tab
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Webhook shared secret — paste the SAME value into:
#   Fapshi dashboard > collection service > Webhook > Secret field
# Max 50 chars. Generate: python -c "import secrets; print(secrets.token_hex(25))"
FAPSHI_WEBHOOK_SECRET=

# ── Redis (Celery broker + result backend) ────────────────────────────────────
# Railway: Add Redis plugin to your project → copy the REDIS_URL it exposes.
# Local dev: redis://localhost:6379/0 (requires Redis installed locally)
REDIS_URL=redis://localhost:6379/0

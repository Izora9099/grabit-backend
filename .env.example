# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Django core ───────────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True

# ── Hosts & CORS ──────────────────────────────────────────────────────────────
# Development: ALLOWED_HOSTS=localhost,127.0.0.1
# Production:  ALLOWED_HOSTS=api.grabit.cm
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed frontend origins (production only)
# CORS_ALLOWED_ORIGINS=https://grabit.cm,https://www.grabit.cm

# ── Database (production PostgreSQL) ─────────────────────────────────────────
# Leave unset when using SQLite (development default)
# DB_NAME=grabit
# DB_USER=grabit_user
# DB_PASSWORD=supersecretpassword
# DB_HOST=localhost
# DB_PORT=5432

# ── Email (production SMTP) ───────────────────────────────────────────────────
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@grabit.cm

# ── SSL (production only) ─────────────────────────────────────────────────────
# SECURE_SSL_REDIRECT=True
